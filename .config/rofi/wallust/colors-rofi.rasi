background-color: #0F1012;
background: rgba(0,0,0,0.7);
foreground: #D1ECF5;
border-color: #0C3E68;

color0: #37383A;
color1: #080C13;
color2: #080C13;
color3: #132361;
color4: #092E4E;
color5: #1A5372;
color6: #5C98AA;
color7: #B5DCE8;
