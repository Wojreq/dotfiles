 /* wallust template - colors-rofi */

* {
active-background: #0C3E68;
active-foreground: #D1ECF5;
normal-background: #0F1012;
normal-foreground: #D1ECF5;
urgent-background: #226F98;
urgent-foreground: #D1ECF5;

alternate-active-background: #1A2F82;
alternate-active-foreground: #D1ECF5;
alternate-normal-background: #0F1012;
alternate-normal-foreground: #D1ECF5;
alternate-urgent-background: #0F1012;
alternate-urgent-foreground: #D1ECF5;

selected-active-background: #0C3E68;
selected-active-foreground: #0F1012;
selected-normal-background: #0C3E68;
