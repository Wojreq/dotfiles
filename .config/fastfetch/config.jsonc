{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "/home/wojciech/Images/logo.png",
    "type": "chafa",
    "width": 28,
    "padding": {
      "top": 1,
      "left": 1
    }
  },
  "display": {
    "separator": " : ",
    "color": {
      "keys": "red",
      "title": "red"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌──────────────────── Hardware ────────────────────┐"
    },
    {
      "type": "host",
      "key": "├─ PC",
      "keyColor": "red"
    },
    {
      "type": "cpu",
      "key": "├─ CPU",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "├─ RAM",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "└─ Disk",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "┌─────────────────── Software ─────────────────────┐"
    },
    {
      "type": "os",
      "key": "├─ OS",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "├─ Kernel",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "├─ Packages",
      "keyColor": "red"
    },
    {
      "type": "shell",
      "key": "├─ Shell",
      "keyColor": "red"
    },
    {
      "type": "de",
      "key": "├─ DE",
      "keyColor": "red"
    },
    {
      "type": "wm",
      "key": "├─ WM",
      "keyColor": "red"
    },
    {
      "type": "terminal",
      "key": "└─ Terminal",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "┌─────────────────── Uptime / DT ──────────────────┐"
    },
    {
      "type": "uptime",
      "key": "├─ Uptime",
      "keyColor": "red"
    },
    {
      "type": "datetime",
      "key": "└─ DateTime",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 1
    }
  ]
}
